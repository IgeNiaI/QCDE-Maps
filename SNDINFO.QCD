// Fortress in The Void
world/quake/buttonpress				QBTNPRS
world/quake/windambience			QWNDAMB
world/bloodfall						BWTRFL

$alias QAmbience1 world/quake/windambience
$ambient 10 QAmbience1 point continuous 1.0

PlatXST			PLAT1ST
PlatXMID		PLAT1MID
PlatXEND		PLAT1END

// Monsoon
$random qcde/thunder { qcde/thunder1 qcde/thunder2 qcde/thunder3 }
qcde/thunder1 	THUNDER1
qcde/thunder2 	THUNDER2
qcde/thunder3 	THUNDER3

// Elder
GoldPickup			GOLDEKEY
SilverPickup		SILVEKEY
RuneSwitch			RUSWITCH
GoldOpen			GOLDOP
SilverOpen			SILVEOP
DoorEnd				DOOREND
Empty				EMPTY
world/Lava			LAVALOOP
world/RailgunRoom	RAILGR
world/ObeliskRoom	OBELISK
StoneRaise			STONERAI
StoneEnd			STONEND
ObeliskRaise		STONERAI
$volume ObeliskRaise 0.3
ObeliskEnd			STONEND
$volume ObeliskEnd 	 0.3
$alias QLava world/Lava
$ambient 1 QLava point continuous 1.0
$alias QRailgun world/RailgunRoom
$ambient 2 QRailgun point continuous 1.0
$alias QObelisk world/ObeliskRoom
$ambient 4 QObelisk point continuous 1.0

// Phrantic
2gdStickMinus 2GDMINUS

// Bad Place
BPL/AmbientFire		AMBFIRE
BPL/AmbientPortal	AMBPORT
BPL/AmbientDrone	AMBDRNE
BPL/AmbientBuzz		AMBBUZZ
BPL/AmbientSuck		AMBSUCK
BPL/AmbientComputer	AMBCOMP
BPL/AmbientMarsh	AMBMRSH

//Corrupted Station
StayinAlive			STAYLIVE
$rolloff StayinAlive 400 700

// Delirium
SHODAN	SHODAN
LiftStart	LIFTSTAR
LiftEnd		LIFTEND

// Gibel Complex
DBTlore	DBTlore
DBTsumm DBTsumm

// Battleforged
DukiNukiTheme			DUKITHM

// Rankin
Ambient/Rain	AMBRAIN

// Deck 17
SteamFx STEAMFX1
$attenuation SteamFx 1.5
$ambient 11 SteamFx point continuous 1.0

UTInterior38 UTINTE38
$ambient 12 UTInterior38 world continuous 0.4

// Minecraft
McPortal MCPORTAL
$attenuation McPortal 3.0
$ambient 13 McPortal point continuous 1.0

McBtnPrs MCBTNPRS

// Arcane Temple
WatrFall WATRFALL
$ambient 14 WatrFall point continuous 1.0

// Duel 1
HereTele STFCRK
$attenuation HereTele 1.0
$ambient 20 HereTele point continuous 1.0

// Claustrophobolis
$volume sounds/water 0.4 
$attenuation sounds/water 2
sounds/water   	     DRIP1

$volume sounds/lava 0.8
sounds/lava   	          LAVA1

$volume sounds/lava/lava2 0.4
sounds/lava/lava2   	LAVA2

$volume sounds/lava3/lava3 0.8
sounds/lava3/lava3   	LAVA3

$volume sounds/lava/lava4 0.8
sounds/lava/lava4   	LAVA4


//DSBDOPN 
sounds/ambient/misc   	DSBDOPN

DECH/Q3TATELEPORT	"Sounds/Q3TATELEPORT.ogg"

sounds/wood1  squeek1
sounds/wood2  squeek2
sounds/wood3  squeek3
$volume sounds/wood1 10
$volume sounds/wood2 10
$volume sounds/wood3 10