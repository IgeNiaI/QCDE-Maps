FreeformMenu QCDE_QCDEMapsInvasion
{
	TopPadding 0
	ScrollSpeed 16
	OverrideHeight 200

	Label {	// generic maps background
		Static
		Background	"BackMaps"
		Size		450, 2000
	}

	Label {
		Pos			0,   10				Font		QCSMFONT
		Text		"Invasion maps"		FontColor	Gold
	}

	Command { Pos -198,   30	Text "QCIN01"	Background PVQCIN01		Command map_QCIN01		Size 96, 54		MouseArea 96, 64	Font SmallFont		SelectedForeground	MAPSELEC, 104, 62		Anchor left, top	FontColor DarkGray		Padding	2, 1 SelectedFontColor Gray	}
	Command { Pos  -98,   30	Text "QCIN02"	Background PVQCIN02		Command map_QCIN02		Size 96, 54		MouseArea 96, 64	Font SmallFont		SelectedForeground	MAPSELEC, 104, 62		Anchor left, top	FontColor DarkGray		Padding	2, 1 SelectedFontColor Gray	}
	Command { Pos    2,   30	Text "QCIN03"	Background PVQCIN03		Command map_QCIN03		Size 96, 54		MouseArea 96, 64	Font SmallFont		SelectedForeground	MAPSELEC, 104, 62		Anchor left, top	FontColor DarkGray		Padding	2, 1 SelectedFontColor Gray	}
	Command { Pos  102,   30	Text "QCIN04"	Background PVQCIN04		Command map_QCIN04		Size 96, 54		MouseArea 96, 64	Font SmallFont		SelectedForeground	MAPSELEC, 104, 62		Anchor left, top	FontColor DarkGray		Padding	2, 1 SelectedFontColor Gray	}
	Label { Pos -150,   84	MaxTextWidth 95		Font SmallFont	Text "Outpost"						}
	Label { Pos  -50,   84	MaxTextWidth 95		Font SmallFont	Text "Hangar"						}
	Label { Pos   50,   84	MaxTextWidth 95		Font SmallFont	Text "Cathedral"					}
	Label { Pos  150,   84	MaxTextWidth 95		Font SmallFont	Text "Asteroid Garden"				}
}

