
AddFreeformMenu "QCDE_SkirmishMenu" below "qcde_randommap"
{
	SubMenu {
		Pos		0, 12				Text				"QC:DE Maps List"	Background			BV21028
		Size	105, 14				Font				SmallFont			SelectedBackground	BV21028S
		Anchor	center, center		FontColor			Tan					menu				QCDE_QCDEMaps
		Padding	0, 0				SelectedFontColor	Tan
	}
}

