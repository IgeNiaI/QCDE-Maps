// to ambient sounds -DBT

// Ambient Sounds

ACTOR AmbientFire 14190
{
	Radius 16
	Height 32
	RenderStyle "None"
	+NOBLOCKMAP
	States
	{
	Spawn:
		HDB1 A -1 NODELAY A_PlaySound ("BPL/AmbientFire",1,0.7,1)
		Stop
	}
}

 
