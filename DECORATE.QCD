ACTOR TeleGlitterRed
{
	+NOBLOCKMAP +NOGRAVITY
	RenderStyle Add

	ReactionTime 14

	States
	{
	Spawn:
		TGLT A 2 BRIGHT A_Countdown
		TGLT B 1 BRIGHT A_Countdown
		TGLT B 1 BRIGHT A_ChangeVelocity(0,0,velz + velz/2.5)
		TGLT C 2 BRIGHT A_Countdown
		TGLT D 1 BRIGHT A_Countdown
		TGLT D 1 BRIGHT A_ChangeVelocity(0,0,velz + velz/2.5)
		TGLT E 2 BRIGHT A_Countdown
		Loop
	}
}

