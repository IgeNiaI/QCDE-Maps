// Decorate file of "Lockbox" by DBThanatos

Actor LockboxSucker 16521
{
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 10
		TNT1 A 0 A_RadiusThrust(-32,160,RTF_NOIMPACTDAMAGE)
		Loop
	}
}

// Decorate file of "Elder" by Ivory Duke

Actor "QSilverKey": CustomInventory 17000
{
	+BRIGHT
	+INVENTORY.NEVERRESPAWN
	Inventory.PickupMessage "Picked up the Silver Key"
	Inventory.PickupSound "SilverPickup"
	Height 64
	Tag "Silver Key"
	States
	{
	Spawn:
		KEY1 A 0
	Idle:
		KEY1 A -1
		Wait
	Pickup:
		KEY1 A 0 A_GiveInventory("SilverToken",1)
		Stop
	}
}

Actor "GoldenKey": CustomInventory 17001
{
	+BRIGHT
	+INVENTORY.NEVERRESPAWN
	Inventory.PickupMessage "Picked up the Golden Key"
	Inventory.PickupSound "GoldPickup"
	Height 64
	Tag "Golden Key"
	States
	{
	Spawn:
		KEY1 A 35 NoDelay
		KEY1 A 35
		KEY1 A 0 ACS_NamedExecuteWithResult("RemoveGoldenKeyIfDuel")
		KEY1 A 35
	Idle:
		KEY1 A -1
		Wait
	Pickup:
		KEY1 A 0 A_GiveInventory("GoldenToken",1)
		Stop
	}
}

Actor "SilverToken": Inventory
{}

Actor "GoldenToken": Inventory
{}

Actor "YouGoodBro": Inventory
{}

